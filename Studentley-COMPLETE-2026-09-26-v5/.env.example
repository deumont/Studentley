# Public browser configuration. These values are identifiers, not secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_APP_URL=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Never put the Google client secret, Supabase service-role key, Stripe secret,
# or OpenAI API key in a VITE_* variable. Keep those server-side only.
